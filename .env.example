# Required for form delivery. CONTACT_FROM must use a Resend-verified domain.
# CONTACT_TO is the mailbox that receives website enquiries.
RESEND_API_KEY=
CONTACT_FROM="Quesiono website <website@quesiono.com>"
CONTACT_TO="quesionowebdesign@gmail.com"

# Optional analytics. Loaded only after consent; DNT/GPC take precedence.
# Configure consent-aware tags and enquiry events in this container.
GTM_ID=
